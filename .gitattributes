# Forcar LF para scripts shell — evita CRLF quebrando heredocs no WSL2
*.sh    text eol=lf
*.bash  text eol=lf

# PowerShell pode usar CRLF no Windows
*.ps1   text eol=crlf

# Texto generico normaliza para LF
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.env   text eol=lf
